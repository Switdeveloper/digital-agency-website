{
  "name": "Facebook Auto Post - Enhanced",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": [
          {
            "mode": "everyDay",
            "hour": 9,
            "minute": 0
          },
          {
            "mode": "everyDay",
            "hour": 14,
            "minute": 30
          },
          {
            "mode": "everyDay",
            "hour": 20,
            "minute": 15
          }
        ]
      },
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "posts",
              "value": "[\n  {\"message\": \"Good morning! Hope you're having a great start to your day! ☀️\", \"link\": \"https://example.com/morning\"},\n  {\"message\": \"Afternoon update: Check out our latest features! 🚀\", \"link\": \"https://example.com/update\"},\n  {\"message\": \"Evening thoughts: What's one thing you learned today? 💭\", \"link\": \"https://example.com/thoughts\"},\n  {\"message\": \"Weekend vibes coming soon! What are your plans? 🎉\", \"link\": \"https://example.com/weekend\"},\n  {\"message\": \"Stay tuned for more exciting content! 🔔\", \"link\": \"https://example.com/stay-tuned\"}\n]"
            }
          ]
        }
      },
      "name": "Set Posts List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        450,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "const posts = $json[\"posts\"];\nconst randomIndex = Math.floor(Math.random() * posts.length);\nreturn [{ json: posts[randomIndex] }];"
      },
      "name": "Select Random Post",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "operation": "createPost",
        "pageId": "",
        "message": "={{ $json[\"message\"] }}",
        "link": "={{ $json[\"link\"] }}",
        "accessToken": "={{ $credentials.facebook.accessToken }}"
      },
      "name": "Facebook Post",
      "type": "n8n-nodes-base.facebook",
      "typeVersion": 1,
      "position": [
        850,
        200
      ]
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [
          {
            "node": "Set Posts List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Posts List": {
      "main": [
        [
          {
            "node": "Select Random Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Select Random Post": {
      "main": [
        [
          {
            "node": "Facebook Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
